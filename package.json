{
  "name": "drive-pdf-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Rebuilds a local PDF from a view-only Google Drive document",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ui": "tsx src/server.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
